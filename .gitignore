# ---- Sistema operativo ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
.vs/
*.swp
*~

# ---- Unreal Engine (generati, da non versionare) ----
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Platforms/*/Binaries/
Platforms/*/Intermediate/

# File progetto Visual Studio generati
*.sln
*.slnx
.vsconfig
shadertoolsconfig.json
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Cache/pref locali dell'utente
*.xcodeproj
*.xcworkspace

# Plugin reinstallato automaticamente da Visual Studio (disabilitato nel .uproject)
Plugins/VisualStudioTools/

# Artefatto spurio da redirect /dev/null su Git Bash (Windows)
/dev/

# ---- Asset UE binari: NON versionati (niente Git LFS, evita costi/repo pesante) ----
# I due asset gia' committati (Content/Materials/M_Unit, Content/Maps/L_Prototype) restano
# tracciati perche' servono all'avvio; da qui in poi i nuovi asset binari sono ignorati.
Content/**/*.uasset
Content/**/*.umap
Content/**/*.fbx
Content/**/*.png
Content/**/*.tga
Content/**/*.jpg
Content/**/*.wav
Content/**/*.mp3
Content/**/*.ogg
Content/**/*.txt

# ---- Eccezioni: questi vanno versionati ----
!Content/**/Binaries/
!Content/Materials/M_Unit.uasset
!Content/Maps/L_Prototype.umap
