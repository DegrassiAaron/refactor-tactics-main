{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RT: Open DEV terminal",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-terminal.ps1",
        "-Role",
        "DEV",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 32
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "icon": {
        "id": "code",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "RT: Open VALIDATION terminal",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-terminal.ps1",
        "-Role",
        "VALIDATION",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 8
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "icon": {
        "id": "beaker",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "RT: Open EDITOR terminal",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-terminal.ps1",
        "-Role",
        "EDITOR",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 8
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "icon": {
        "id": "tools",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "RT: Open role set (DEV + VALIDATION + EDITOR)",
      "dependsOn": [
        "RT: Open DEV terminal",
        "RT: Open VALIDATION terminal",
        "RT: Open EDITOR terminal"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "RT: Open 3 terminals",
      "dependsOn": [
        "RT: Open DEV terminal",
        "RT: Open VALIDATION terminal",
        "RT: Open EDITOR terminal"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "RT: Workspace status",
      "detail": "Identita' del workspace e registro per macchina. Non acquisisce Unreal.",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-workspace.ps1",
        "-Action",
        "status",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RT: Engine lease status",
      "detail": "Chi possiede il motore, e quali processi Unreal sono vivi. Non acquisisce niente.",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-lease.ps1",
        "-Action",
        "status",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RT: Engine lease acquire",
      "detail": "Prende il motore just-in-time. Chiede operazione e task id.",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-lease.ps1",
        "-Action",
        "acquire",
        "-Operation",
        "${input:rtOperation}",
        "-TaskId",
        "${input:rtTaskId}",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RT: Engine lease release",
      "detail": "Rilascia il motore. Fallisce se un processo Unreal posseduto e' ancora vivo.",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-lease.ps1",
        "-Action",
        "release",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RT: MCP asset-write preflight",
      "detail": "Verifica la policy MAIN-only prima di mutare asset via MCP. Non intercetta la chiamata.",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\rt-mcp-guard.ps1",
        "-Action",
        "check",
        "-Operation",
        "MCP_ASSET_WRITE",
        "-TaskId",
        "${input:rtTaskId}",
        "-AssetWriteSet",
        "${input:rtAssetWriteSet}",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "rtOperation",
      "type": "pickString",
      "description": "Operazione per cui serve il motore",
      "options": [
        "BUILD",
        "SUITE",
        "EDITOR",
        "PIE",
        "COMMANDLET",
        "MCP_EDITOR_QUERY",
        "MCP_ASSET_WRITE"
      ],
      "default": "SUITE"
    },
    {
      "id": "rtTaskId",
      "type": "promptString",
      "description": "Task/issue id (obbligatorio per le operazioni mutanti)"
    },
    {
      "id": "rtAssetWriteSet",
      "type": "promptString",
      "description": "Asset che intendi toccare, separati da virgola"
    }
  ]
}
